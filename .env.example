BOT_TOKEN=123456:replace_with_bot_token
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Your Telegram numeric user ID(s), comma-separated.
ADMIN_IDS=123456789
FREE_LIMIT=3
# URL of your self-hosted Wan2.1 GPU worker reachable from Railway
GPU_WORKER_URL=https://your-private-worker-host
GPU_WORKER_TOKEN=replace_with_a_long_random_secret
# Optional polling interval in milliseconds
POLL_MS=7000
# If your external Postgres requires TLS, set to require
# PGSSLMODE=require
